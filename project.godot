config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Dread of the Dead Demo"
run/main_scene="uid://di3if1iwu4h4e"
config/use_hidden_project_data_directory=false
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://br8wpea5b5i02"
config/icon="uid://qdvt2rsxcrif"

[autoload]

global="*uid://bkselok1hufca"
WorldState="*uid://bi2jd2puk83em"
TransitionManager="*uid://dulbgxm5l4a7o"
SoundManager="*uid://6n70ld1jrf1f"

[display]

